---
/**
 * The document shell every page shares: head, fonts, skip link, footer.
 *
 * Page-specific chrome (the learn header, an article's prose column) lives in
 * the layout that wraps this one, not here.
 */
import { Font } from 'astro:assets';
import Seo from '../components/seo/Seo.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: object[];
  /** The learn screen supplies its own footer inside the layout. */
  hideFooter?: boolean;
  bodyClass?: string;
}

const { hideFooter = false, bodyClass = '', ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0b0e" />

    <Seo {...seo} />

    {/*
      Three renderings of one mark (src/lib/favicon.ts draws the last two from
      the first): the SVG for anything that takes it, a PNG for clients that
      only take a raster icon, and the .ico for the rest. The .ico is also what
      a client fetches from the root without being told to, so it is declared
      here for the size hint rather than because the link is needed.
    */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="learntmux guides" href="/rss.xml" />

    {/* Self-hosted, so there is no third-party stylesheet in the critical path. */}
    <Font cssVariable="--font-instrument-sans" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    {/*
      Scroll-driven animation is progressive enhancement. Setting the class
      before first paint avoids a flash of the animated layout on browsers that
      cannot run it, and honours a reduced-motion preference.
    */}
    <script is:inline>
      (function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var supported =
          window.CSS && CSS.supports && CSS.supports('animation-timeline', 'view()');
        if (reduced || !supported) document.documentElement.classList.add('no-scroll-motion');
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    {!hideFooter && <SiteFooter />}
  </body>
</html>
