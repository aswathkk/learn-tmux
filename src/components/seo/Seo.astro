---
/**
 * Every meta tag a page needs, in one place.
 *
 * Canonical URLs are built from `Astro.site` and the current path, so they are
 * always absolute and always carry the trailing slash the site is configured
 * for. Any page that can be reached at more than one URL must pass an explicit
 * `canonical`.
 */
import { canonicalPath, DEFAULT_SOCIAL_IMAGE, SITE_NAME, TWITTER_CARD } from '../../lib/seo';
import { ogImagePath, ogTargetFor } from '../../lib/og-cards';

interface Props {
  title: string;
  description: string;
  /** Overrides the derived canonical. Use for paginated or filtered views. */
  canonical?: string;
  /**
   * Social card image, site-relative. Optional: a page that draws one (see
   * src/lib/og-cards.ts) is found by its own URL, so only a page with an image
   * of its own — a guide's cover, a gallery screenshot — passes this.
   */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Thin or duplicated pages: keep them out of the index and the sitemap. */
  noindex?: boolean;
  /** Schema.org objects, serialised one <script> each. */
  jsonLd?: object[];
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const path = canonicalPath(canonical ?? Astro.url.pathname);
const canonicalUrl = new URL(path, Astro.site);

/**
 * The page's own card, if the site draws one for it.
 *
 * Looked up here rather than passed in by every page, because "this page has a
 * card" is already recorded in one place and asking each page to repeat it is
 * how a page ends up unfurling as the generic site image. An explicit `image`
 * still wins: a guide's cover is a better card than anything drawn from its
 * title.
 */
const drawn = image ? undefined : await ogTargetFor(path);
const card = image ?? (drawn ? ogImagePath(drawn.page) : DEFAULT_SOCIAL_IMAGE);
const cardAlt = imageAlt ?? drawn?.alt ?? 'learntmux — learn tmux in a live terminal';

const imageUrl = new URL(card, Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  )
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={cardAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en" />

{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content={TWITTER_CARD} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={cardAlt} />

{
  jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  ))
}
