---
/**
 * What finishing a level looks like.
 *
 * A preview of the real completion state, built from the level's own numbers
 * and the bindings it banks.
 *
 * It shows only what is knowable in advance. A reader's own time and hint count
 * belong to their run of the level, not to a page describing it.
 */
import Kbd from '../ui/Kbd.astro';
import { formatDuration, type LandingCompletion } from '../../lib/landing';

interface Props {
  completion: LandingCompletion;
}

const { completion } = Astro.props;

const stats = [
  { value: String(completion.taskCount), label: 'tasks' },
  { value: formatDuration(completion.minutes), label: 'about' },
  { value: `+${completion.keyCount}`, label: 'shortcuts banked', accent: true },
];
---

<section id="level-complete" class="mx-auto max-w-[1200px] px-5 py-[16vh] sm:px-[clamp(20px,5vw,72px)]">
  <div
    class="relative grid overflow-hidden rounded-[22px] border border-white/10 bg-ink-raised [animation-range:entry_0%_entry_60%] [animation-timeline:view()] [animation:upSoft_linear_both] md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]"
  >
    <div class="absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,transparent,var(--color-accent),transparent)]"></div>
    <div class="pointer-events-none absolute inset-x-0 -top-[140px] h-[280px] [background:radial-gradient(closest-side_at_50%_50%,rgb(var(--accent-rgb)/.16),transparent)]"></div>

    <div class="relative flex flex-col gap-[22px] p-7 sm:p-[clamp(28px,4vw,52px)]">
      <div class="flex items-center gap-[14px]">
        <div
          class="relative grid h-14 w-14 flex-none place-items-center rounded-full"
          style="background:conic-gradient(var(--color-accent) 100%, rgba(255,255,255,.08) 0);"
        >
          <div class="grid h-11 w-11 place-items-center rounded-full bg-ink-raised font-mono text-[18px] font-semibold text-accent">
            ✓
          </div>
        </div>
        <div>
          <div class="font-mono text-xs font-medium tracking-[.12em] text-accent">
            LEVEL {completion.level.n} · {completion.level.name.toUpperCase()}
          </div>
          <div class="mt-[3px] text-[13px] text-fg-dim">
            Ends with a challenge: {completion.lessonTitle}
          </div>
        </div>
      </div>

      <h2
        class="m-0 font-bold [text-wrap:balance]"
        style="font-size:clamp(30px,3.8vw,54px); letter-spacing:-.03em; line-height:1.02;"
      >
        Every level ends by proving you can use it.
      </h2>
      <p class="m-0 max-w-[46ch] text-base leading-[1.55] text-fg-muted [text-wrap:pretty]">
        The last task in a level states an end state instead of steps and teaches no new keys.
        You get there with what the level already gave you, or you do not get there.
      </p>

      <dl class="grid grid-cols-3 gap-[10px]">
        {
          stats.map((stat) => (
            <div class="rounded-xl border border-line bg-ink px-4 py-[14px]">
              <dd
                class:list={[
                  'm-0 font-mono text-2xl font-semibold leading-none tracking-[-.02em]',
                  stat.accent && 'text-accent',
                ]}
              >
                {stat.value}
              </dd>
              <dt class="mt-[6px] text-[13px] text-fg-dim">{stat.label}</dt>
            </div>
          ))
        }
      </dl>

      <div class="flex flex-wrap items-center gap-[14px] pt-1">
        <a
          href={completion.href}
          class="inline-flex items-center gap-[10px] rounded-[10px] bg-accent px-5 py-[13px] text-sm font-bold text-ink"
        >
          See the {completion.level.name} challenge <span aria-hidden="true">→</span>
        </a>
        <a href="#levels" class="inline-flex min-h-[44px] items-center py-1 text-sm font-medium text-fg-muted">
          All levels
        </a>
      </div>
    </div>

    <div class="relative flex flex-col gap-[14px] border-l border-line bg-ink p-7 sm:p-[clamp(28px,4vw,52px)]">
      <div class="flex items-baseline justify-between">
        <span class="text-sm font-semibold">Added to your cheat sheet</span>
        <span class="font-mono text-[11px] font-medium text-fg-dim">
          {completion.keyCount} in this level
        </span>
      </div>
      <ul class="flex flex-col gap-[6px] text-sm">
        {
          completion.keys.map((entry) => (
            <li class="flex flex-wrap items-center justify-between gap-3 rounded-[9px] bg-ink-card px-3 py-[10px]">
              <span class="text-[13px] text-fg-muted">{entry.description}</span>
              <Kbd keys={entry.key} size="sm" class="flex-none" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
