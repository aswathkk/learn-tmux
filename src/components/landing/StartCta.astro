---
/**
 * The way in, at the end of the page.
 *
 * Without this the page finishes on links to guides and the gallery, and
 * someone who has just read the whole thing has to scroll back to the top to
 * act on it.
 *
 * It repeats the hero's ask rather than making a new one, and answers the only
 * question left at this point: what am I actually about to be asked to do. The
 * right half is task one itself — its end state and the keys it teaches — read
 * from the lesson, so it cannot describe a task that is not there. Showing the
 * work is a better argument than another sentence about it.
 */
import Kbd from '../ui/Kbd.astro';
import { renderInline } from '../../lib/inline-markdown';
import type { LandingFirstTask } from '../../lib/landing';

interface Props {
  firstTask: LandingFirstTask;
  startHref: string;
}

const { firstTask, startHref } = Astro.props;
---

<section
  id="start-cta"
  class="mx-auto max-w-[1200px] px-5 pb-[10vh] sm:px-[clamp(20px,5vw,72px)] sm:pb-[14vh]"
>
  <div
    class="relative grid overflow-hidden rounded-[22px] border border-line-strong bg-ink-raised md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]"
  >
    <div class="absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,transparent,var(--color-accent),transparent)]"></div>
    <div class="pointer-events-none absolute inset-x-0 -top-[140px] h-[280px] [background:radial-gradient(closest-side_at_50%_50%,rgb(var(--accent-rgb)/.16),transparent)]"></div>

    <div class="relative flex flex-col items-start gap-5 p-5 sm:p-[clamp(28px,4vw,52px)]">
      <h2
        class="m-0 font-bold [text-wrap:balance]"
        style="font-size:clamp(28px,3.4vw,46px); letter-spacing:-.03em; line-height:1.04;"
      >
        {firstTask.minutes} minutes is enough to find out if this suits you.
      </h2>
      <p class="m-0 max-w-[52ch] text-base leading-[1.55] text-fg-muted [text-wrap:pretty]">
        A real tmux session opens in this tab — nothing to install, no account, and you can
        close it whenever you like. Whatever you finish is remembered by this browser.
      </p>

      <a
        href={startHref}
        data-resume-link
        class="mt-1 rounded-[10px] bg-accent px-[26px] py-[16px] text-base font-bold text-ink"
      >
        <span data-resume-label>Start the first task</span> <span aria-hidden="true">→</span>
      </a>
    </div>

    {/* Task one, as the lesson states it. From md up: on a phone the caption
        under the hero's button has already named it, and the panel doubled
        the height of the closing ask. */}
    <div
      class="relative hidden flex-col gap-[14px] border-line bg-ink p-5 max-md:border-t sm:p-[clamp(28px,4vw,52px)] md:flex md:border-l"
    >
      <div class="flex items-baseline justify-between gap-3">
        <span class="text-sm font-semibold">{firstTask.title}</span>
        <span class="font-mono text-[11px] font-medium text-fg-dim">{firstTask.minutes} min</span>
      </div>
      <p
        class="m-0 text-[13px] leading-[1.55] text-fg-muted"
        set:html={renderInline(firstTask.objective)}
      />
      <ul class="mt-1 flex flex-col gap-[6px] text-sm">
        {
          firstTask.keys.map((entry) => (
            <li class="flex flex-wrap items-center justify-between gap-3 rounded-[9px] bg-ink-card px-3 py-[10px]">
              <span class="text-[13px] text-fg-muted">{entry.description}</span>
              <Kbd keys={entry.key} size="sm" class="flex-none" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
