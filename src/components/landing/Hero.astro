---
/**
 * The hero.
 *
 * One ask, stated small: the first task, by name, with the minutes it takes.
 * The course total is deliberately absent — the whole course is not what anyone
 * is being asked to agree to here, and quoting hours in the first screen turns
 * a three-minute try into a decision.
 *
 * There is one button and nothing beside it competing for the eye. Everything
 * that was a second and third way in — the playground, the levels, the counts —
 * is either in the nav above or further down the page, where someone who wants
 * it will look for it.
 */
import Wordmark from '../ui/Wordmark.astro';
import GitHubLink from '../ui/GitHubLink.astro';
import type { LandingFirstTask } from '../../lib/landing';

interface Props {
  startHref: string;
  firstTask: LandingFirstTask;
}

const { startHref, firstTask } = Astro.props;
---
<section
  id="hero"
  class="hero-section relative overflow-hidden px-5 pb-[4vh] sm:px-[clamp(20px,5vw,72px)] lg:min-h-screen lg:pb-0"
>
  <div
    class="pointer-events-none absolute -inset-x-[10%] bottom-[4%] top-auto h-[46%] [background:radial-gradient(ellipse_at_50%_50%,rgb(var(--accent-rgb)/.09),transparent_70%)]"
  ></div>

  {/* Three navs on the page — this one and the footer's two — so it says which. */}
  <nav
    aria-label="Main"
    class="relative mx-auto flex max-w-[1200px] items-center justify-between gap-3 py-[26px]"
  >
    {/*
      No button up here. The hero's own button is a few lines down and is the
      one ask on the screen; a second one in the corner was the same ask twice.
      The wordmark scales with the viewport so it never crowds the narrowest
      phones, where it is the only thing in this row.
    */}
    <a href="/" aria-label="learntmux.dev — home"><Wordmark size="clamp(15px, 4.4vw, 21px)" /></a>
    <span class="hidden shrink-0 items-center gap-[26px] text-sm font-medium md:flex">
      <a href="#levels" class="inline-flex min-h-[44px] items-center text-fg-muted transition-colors hover:text-fg">Levels</a>
      <a href="/playground" class="inline-flex min-h-[44px] items-center text-fg-muted transition-colors hover:text-fg">Playground</a>
      <a href="/guides" class="inline-flex min-h-[44px] items-center text-fg-muted transition-colors hover:text-fg">Guides</a>
      <a href="/cheatsheet" class="inline-flex min-h-[44px] items-center text-fg-muted transition-colors hover:text-fg">Cheat sheet</a>
      <a href="/gallery" class="inline-flex min-h-[44px] items-center text-fg-muted transition-colors hover:text-fg">Gallery</a>
      <GitHubLink size="18px" class="inline-flex min-h-[44px] text-fg-muted hover:text-fg" />
    </span>
  </nav>

  <div class="rail-grid relative mx-auto max-w-[1200px] items-start">
    <div class="flex flex-col gap-[26px] pt-[3vh]">
      <span class="font-mono text-xs font-medium tracking-[.12em] text-accent">
        REAL TMUX · IN THIS TAB · NOTHING TO INSTALL
      </span>
      <h1
        class="m-0 font-bold [text-wrap:balance]"
        style="font-size:clamp(40px,5.2vw,74px); line-height:1; letter-spacing:-.035em;"
      >
        Learn tmux by doing it, not reading about it.
      </h1>
      <p class="m-0 max-w-[46ch] text-lg leading-[1.55] text-fg-muted [text-wrap:pretty]">
        A real tmux session runs in this tab. You type, it watches, and the list ticks itself
        off the moment you get it right. Nothing to install, no account.
      </p>
      {/*
        Says "Start" until the browser reports progress, then becomes "Resume"
        pointing at the next unfinished task; rendered in its starting state so
        it is right for a first-time visitor with no JavaScript. Grouped with
        its caption so the two are rewritten together: a button offering to
        resume above a line promising task one is worse than either alone.
      */}
      <div class="flex flex-col gap-3" data-resume-group>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={startHref}
            data-resume-link
            class="rounded-[10px] bg-accent px-[26px] py-[16px] text-base font-bold text-ink"
          >
            <span data-resume-label>Start the first task</span> <span aria-hidden="true">→</span>
          </a>
          <a href="#levels" class="py-[14px] text-[15px] text-fg-dim underline decoration-line-strong hover:text-accent">
            See the levels
          </a>
        </div>
        {/* What is actually behind the button, so pressing it is not a leap. */}
        <p class="m-0 text-[13px] text-fg-dim" data-resume-sub>
          First one up: <span class="text-fg-muted">{firstTask.title}</span> · about {firstTask.minutes} minutes
        </p>
      </div>
    </div>
    <div aria-hidden="true"></div>
  </div>
</section>
