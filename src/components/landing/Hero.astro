---
/**
 * The hero.
 *
 * Every number on it is counted from the lessons at build time. The nav points
 * at pages that exist, and the primary action goes to the first task rather
 * than to an anchor further down the page.
 */
import Wordmark from '../ui/Wordmark.astro';
import { formatDuration } from '../../lib/landing';
import type { CourseStats } from '../../lib/lessons';

interface Props {
  stats: CourseStats;
  startHref: string;
  levelCount: number;
}

const { stats, startHref, levelCount } = Astro.props;

const facts = [
  { value: formatDuration(stats.minutes), label: 'end to end' },
  { value: '0', label: 'installs' },
  { value: String(stats.keys), label: 'shortcuts' },
];
---
<section
  id="hero"
  class="hero-section relative overflow-hidden px-5 pb-[8vh] sm:px-[clamp(20px,5vw,72px)] lg:min-h-screen lg:pb-0"
>
  <div
    class="pointer-events-none absolute -inset-x-[10%] bottom-[4%] top-auto h-[46%] [background:radial-gradient(ellipse_at_50%_50%,rgb(var(--accent-rgb)/.09),transparent_70%)]"
  ></div>

  <nav class="relative mx-auto flex max-w-[1200px] items-center justify-between py-[26px]">
    <a href="/" aria-label="learntmux.dev — home"><Wordmark size="clamp(17px, 4.4vw, 21px)" /></a>
    <div class="flex items-center gap-[26px] text-sm font-medium">
      <span class="hidden items-center gap-[26px] md:flex">
        <a href="#levels" class="inline-flex min-h-[44px] items-center text-fg-muted transition-colors hover:text-fg">Levels</a>
        <a href="/playground" class="inline-flex min-h-[44px] items-center text-fg-muted transition-colors hover:text-fg">Playground</a>
        <a href="/guides" class="inline-flex min-h-[44px] items-center text-fg-muted transition-colors hover:text-fg">Guides</a>
        <a href="/cheatsheet" class="inline-flex min-h-[44px] items-center text-fg-muted transition-colors hover:text-fg">Cheat sheet</a>
        <a href="/gallery" class="inline-flex min-h-[44px] items-center text-fg-muted transition-colors hover:text-fg">Gallery</a>
      </span>
      {/*
        Says "Start" until the browser reports progress, then becomes "Resume"
        pointing at the next unfinished task. Rendered in its starting state so
        it is correct for a first-time visitor with no JavaScript.
      */}
      <a
        href={startHref}
        data-resume-link
        class="inline-flex min-h-[44px] items-center whitespace-nowrap rounded-lg bg-fg px-4 font-semibold text-ink"
      >
        <span data-resume-label>Start Level 1</span>
      </a>
    </div>
  </nav>

  <div class="rail-grid relative mx-auto max-w-[1200px] items-start">
    <div class="flex flex-col gap-[26px] pt-[3vh]">
      <span class="font-mono text-xs font-medium tracking-[.12em] text-accent">
        {levelCount} LEVELS · {stats.lessons} TASKS · REAL TERMINAL
      </span>
      <h1
        class="m-0 font-bold [text-wrap:balance]"
        style="font-size:clamp(40px,5.2vw,74px); line-height:1; letter-spacing:-.035em;"
      >
        Learn tmux by doing it, not reading about it.
      </h1>
      <p class="m-0 max-w-[46ch] text-lg leading-[1.55] text-fg-muted [text-wrap:pretty]">
        Short levels from your first session to your own config. Every task happens in a real
        tmux session running in this tab. We watch it and tick things off the moment you get
        them right.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={startHref}
          class="rounded-[10px] bg-accent px-[22px] py-[14px] text-[15px] font-bold text-ink"
        >
          Start the first task
        </a>
        <a
          href="#levels"
          class="rounded-[10px] border border-line-strong px-[18px] py-[14px] text-[15px] font-semibold"
        >
          See the levels ↓
        </a>
        {/*
          Not everyone arriving here wants to be taught. The third way in is a
          terminal with nothing attached to it, which is also the page people
          search for by name.
        */}
        <a href="/playground" class="py-[14px] text-[15px] text-fg-dim underline decoration-line-strong hover:text-accent">
          Or just open a terminal
        </a>
      </div>
      <dl class="flex gap-7 pt-[6px] text-[13px] text-fg-dim">
        {
          facts.map((fact) => (
            /*
              Definition order stays dt-then-dd for assistive tech; `order`
              flips them visually so the number reads first. Labelling it twice
              — once visibly, once for screen readers — made it announce as
              "end to end 3h 2m end to end".
            */
            <div class="flex items-baseline gap-[6px]">
              <dt class="order-2">{fact.label}</dt>
              <dd class="order-1 m-0 font-mono text-[18px] font-semibold text-fg">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div aria-hidden="true"></div>
  </div>
</section>
