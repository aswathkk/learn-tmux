---
import Terminal from './Terminal.astro';

const steps = [
  {
    label: 'LEVEL 1 · TASK 2 / 10',
    title: 'Split the pane side by side',
    keys: ['C-b', '%'],
    badge: '✓ 0:14',
    range: 'contain 0% contain 12%',
  },
  {
    label: 'LEVEL 1 · TASK 3 / 10',
    title: 'Split the pane top and bottom',
    keys: ['C-b', '"'],
    badge: '✓ 0:09',
    range: 'contain 28% contain 40%',
  },
  {
    label: 'LEVEL 1 · TASK 4 / 10',
    title: 'Move between panes',
    keys: ['C-b', '←'],
    badge: 'watching',
    watching: true,
    range: 'contain 56% contain 68%',
  },
];
---
<section id="lesson" class="lesson-section px-5 pt-[8vh] sm:px-[clamp(20px,5vw,72px)]">
  <div class="mx-auto max-w-[1200px]">
  <div class="rail-grid lesson-rail items-start">
    <div class="lesson-left">
    <div class="lesson-intro">
      <div class="max-w-[46ch]">
      <span class="font-mono text-xs font-medium tracking-[.12em] text-accent">HOW A LESSON WORKS</span>
      <h2
        class="m-0 mt-[10px] font-bold [text-wrap:balance]"
        style="font-size:clamp(30px,3.6vw,50px); letter-spacing:-.03em; line-height:1.04;"
      >
        The terminal stays put. It changes as you do.
      </h2>
      <p class="m-0 mt-[14px] text-base leading-[1.55] text-fg-muted [text-wrap:pretty]">
        Still the same session you started at the top of the page: window
        <span class="font-mono text-fg">3:lesson</span>, opened when you pressed the prefix.
        Every task below drives it.
      </p>
      </div>
    </div>

    <div class="lesson-steps flex flex-col gap-[28vh] pb-[10vh] pt-[37vh]">
      {steps.map((step, i) => (
        <div
          class="lesson-step flex flex-col gap-3 rounded-[14px] border border-white/10 bg-ink-card p-[22px]"
          style={`view-timeline-name:--step${i + 1};animation-timeline:--step${i + 1};`}
        >
          <span class="font-mono text-[11px] font-medium tracking-[.1em] text-accent">{step.label}</span>
          <h3 class="text-[22px] font-bold tracking-[-.02em]">{step.title}</h3>
          <div class="flex items-center gap-2 rounded-[10px] bg-ink p-3 font-mono text-[13px] font-semibold">
            <span class="rounded-[6px] border border-white/[.12] bg-ink-key px-[10px] py-[6px]">{step.keys[0]}</span>
            <span class="text-fg-dim">then</span>
            <span class="rounded-[6px] border border-white/[.12] bg-ink-key px-[10px] py-[6px]">{step.keys[1]}</span>
            {step.watching ? (
              <span class="ml-auto flex items-center gap-[6px] font-mono text-xs font-medium text-accent">
                <span class="h-[6px] w-[6px] rounded-full bg-accent"></span>
                {step.badge}
              </span>
            ) : (
              <span class="ml-auto font-mono text-xs font-medium text-accent">{step.badge}</span>
            )}
          </div>
        </div>
      ))}
    </div>
    </div>

    <div>
      <Terminal mode="lesson" class="terminal-static" />
    </div>
  </div>
  </div>
</section>
