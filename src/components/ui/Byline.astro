---
/**
 * Who wrote it: face, name, link.
 *
 * One component for both collections, so a guide's byline and a gallery
 * entry's credit are the same object in the same arrangement wherever they
 * appear — an index row, a card, or the head of an article.
 *
 * The avatar carries an empty alt on purpose. The name sits next to it in
 * text, so describing the face again would have a screen reader read the
 * person twice.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Author {
  name: string;
  url?: string;
  avatar?: ImageMetadata;
}

interface Props {
  author: Author;
  /** `sm` for a list row or a card, `md` for the head of an article. */
  size?: 'sm' | 'md';
  /**
   * Third-party links are nofollow. The gallery links to strangers' profiles
   * and cannot vouch for them; a guide links to its own author and can.
   */
  nofollow?: boolean;
  class?: string;
}

const { author, size = 'sm', nofollow = false, class: className = '' } = Astro.props;

const px = size === 'md' ? 28 : 20;
const rel = ['author', 'noopener', nofollow && 'nofollow'].filter(Boolean).join(' ');
---
<span class:list={['inline-flex items-center gap-2', className]}>
  {
    author.avatar && (
      <Image
        src={author.avatar}
        alt=""
        width={px * 2}
        height={px * 2}
        style={`width:${px}px;height:${px}px`}
        class="shrink-0 rounded-full border border-line-strong object-cover"
        loading="lazy"
      />
    )
  }
  {
    author.url ? (
      <a
        href={author.url}
        rel={rel}
        class:list={[
          'text-fg-dim transition-colors hover:text-accent hover:underline',
          size === 'md' && 'text-[13px]',
        ]}
      >
        {author.name}
      </a>
    ) : (
      <span class:list={['text-fg-dim', size === 'md' && 'text-[13px]']}>{author.name}</span>
    )
  }
</span>
