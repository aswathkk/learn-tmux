---
/**
 * The category row under an index heading.
 *
 * Real links to real pages, not a filter. Every category is a page with its own
 * copy — "tmux status line config" and "minimal tmux config" are two searches,
 * and a single index filtered by JavaScript can only ever answer one of them.
 * It also means the row works before, during and without JavaScript.
 */
interface Item {
  href: string;
  name: string;
  count: number;
}

interface Props {
  /** Where "all" points: the unfiltered index. */
  allHref: string;
  allLabel: string;
  total: number;
  items: Item[];
  /** The href of the page being viewed, so it can be marked. */
  active?: string;
  class?: string;
}

const { allHref, allLabel, total, items, active = '', class: className = '' } = Astro.props;

const chips = [{ href: allHref, name: allLabel, count: total }, ...items];
---
{
  items.length > 0 && (
    <nav aria-label="Categories" class={className}>
      <ul class="flex flex-wrap gap-2">
        {chips.map((chip) => {
          const current = chip.href === active;
          return (
            <li>
              <a
                href={chip.href}
                aria-current={current ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-[34px] items-center gap-1.5 rounded-full border px-3 text-[13px] transition-colors',
                  current
                    ? 'border-accent/40 bg-accent/10 text-accent'
                    : 'border-line text-fg-muted hover:border-accent/30 hover:text-fg',
                ]}
              >
                {chip.name}
                <span class:list={['font-mono text-[11px]', current ? 'text-accent/70' : 'text-fg-faint']}>
                  {chip.count}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}
