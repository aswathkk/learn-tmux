---
/**
 * A link to the source, drawn as the GitHub mark.
 *
 * One component rather than an SVG pasted into four headers, so the path and
 * the link's target can never drift apart. It opens in a new tab on purpose:
 * from the learn screen a same-tab navigation would throw away a running
 * machine and everything typed into it.
 *
 * No display utility here — the caller sets `inline-flex`, or `hidden
 * sm:inline-flex` where the bar is too narrow for one more thing.
 */
import { REPO_URL } from '../../lib/seo';

interface Props {
  /** The mark's size, any CSS length. */
  size?: string;
  /** Text beside the mark. Without it the link is icon-only, and says so to assistive tech. */
  label?: string;
  class?: string;
}

const { size = '18px', label, class: className } = Astro.props;
---
<a
  href={REPO_URL}
  target="_blank"
  rel="noopener"
  aria-label={label ? undefined : 'learntmux on GitHub'}
  class:list={['items-center gap-2 transition-colors', className]}
>
  <svg aria-hidden="true" viewBox="0 0 16 16" width={size} height={size} fill="currentColor">
    <path
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
    ></path>
  </svg>
  {label && <span>{label}</span>}
</a>
