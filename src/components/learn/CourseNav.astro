---
/**
 * The "Level 1 · Basics · Task 3 of 11 ▾" control.
 *
 * One <details>, one panel, both halves of "where am I" switchable: a rail of
 * the four levels down the left, the tasks of the selected level on the right.
 * Clicking the level half of the summary and clicking the task half open the
 * same thing, because they are the same question.
 *
 * No JavaScript is required for any of it. <details> opens the panel; the level
 * rail is a radio group, and the sibling combinator in global.css shows the list
 * belonging to whichever radio is checked. Every task in the course is a real
 * link in the HTML, so the whole course is crawlable from any lesson in it —
 * not just the level you happen to be inside.
 */
import type { LessonEntry } from '../../lib/lessons';
import { lessonPath, levelPath } from '../../lib/lessons';
import { levels } from '../../lib/levels';
import type { Level } from '../../lib/levels';

interface Props {
  current: LessonEntry;
  currentLevel: Level;
  /** Every lesson in the course, in course order. */
  lessons: LessonEntry[];
  position: number;
  totalInLevel: number;
}

const { current, currentLevel, lessons, position, totalInLevel } = Astro.props;

const groups = levels.map((level) => ({
  level,
  lessons: lessons.filter((lesson) => lesson.data.level === level.n),
}));
---

<details class="course-nav relative" data-course-nav>
  {/*
    The vertical padding is pulled back out with a negative margin: the control
    keeps the 20px it is drawn at and gets the 44px it is tapped at.
  */}
  <summary
    class="flex cursor-pointer list-none items-center gap-[7px] py-3 -my-3 text-[13px] text-fg-muted transition-colors hover:text-fg"
    aria-label={`Course navigation. Level ${currentLevel.n}, ${currentLevel.name}, task ${position} of ${totalInLevel}`}
  >
    <span class="hidden whitespace-nowrap sm:inline">
      Level {currentLevel.n} · {currentLevel.name}
    </span>
    <span aria-hidden="true" class="hidden text-fg-faint sm:inline">·</span>
    <span class="whitespace-nowrap text-fg-dim">Task {position} of {totalInLevel}</span>
    <span aria-hidden="true" class="course-nav-chevron text-[10px] text-fg-faint">&#9662;</span>
  </summary>

  {/*
    Hung off the control from sm up, hung off the viewport below it. The control
    sits some way into a 52px bar, so a panel anchored to its left edge on a
    phone starts 170px in and runs off the right of the screen — which is what
    the old task list did, at every width under about 500px.
  */}
  <div
    class="fixed inset-x-3 top-[62px] z-30 overflow-hidden rounded-xl border border-line-strong bg-ink-raised shadow-[0_24px_60px_rgba(0,0,0,.6)] sm:absolute sm:inset-x-auto sm:left-0 sm:top-[calc(100%+14px)] sm:w-[min(580px,calc(100vw-32px))]"
  >
    {/*
      The radios sit before the body so a plain sibling combinator can reach both
      the tab that is checked and the list it belongs to. They are off-screen
      rather than `display:none`, which would take them out of the tab order and
      out of the arrow-key group a radio set gets for free.
    */}
    {
      groups.map(({ level }) => (
        <input
          type="radio"
          name="course-nav-level"
          id={`course-nav-level-${level.n}`}
          class="course-nav-radio"
          checked={level.n === currentLevel.n}
          data-nav-radio={level.n}
          data-nav-default={level.n === currentLevel.n ? '' : undefined}
          aria-label={`Level ${level.n}, ${level.name}`}
        />
      ))
    }

    <div class="course-nav-body flex flex-col sm:flex-row">
      {/*
        A rail on wide screens, chips on narrow ones. They wrap rather than
        scroll sideways: four is few enough to fit in two rows, and a level you
        have to swipe to reach is a level you will not know is there.
      */}
      <div
        class="flex flex-none flex-wrap gap-1 border-b border-line p-2 sm:w-[172px] sm:flex-col sm:flex-nowrap sm:border-b-0 sm:border-r"
        role="group"
        aria-label="Levels"
      >
        {
          groups.map(({ level, lessons: inLevel }) => (
            <label
              for={`course-nav-level-${level.n}`}
              data-nav-tab={level.n}
              class="course-nav-tab flex min-h-[40px] flex-none cursor-pointer items-center gap-[10px] whitespace-nowrap rounded-lg px-[10px] py-2 text-[13px] text-fg-dim transition-colors hover:bg-line-faint hover:text-fg sm:w-full sm:flex-none"
            >
              <span class="font-mono text-[11px] text-fg-faint" data-nav-tab-n>
                {level.n}
              </span>
              <span class="flex min-w-0 flex-col gap-[1px]">
                <span class="truncate">{level.name}</span>
                {/* Filled in by the client from saved progress; 0 until then. */}
                <span
                  class="hidden font-mono text-[10px] text-fg-faint sm:inline"
                  data-nav-level-count={level.n}
                >
                  0/{inLevel.length}
                </span>
              </span>
            </label>
          ))
        }
      </div>

      <div class="min-w-0 flex-1 overflow-y-auto overscroll-contain max-h-[min(60vh,392px)]">
        {
          groups.map(({ level, lessons: inLevel }) => (
            <div data-nav-list={level.n} class="course-nav-list p-2">
              {/*
                The level hub used to be the link in the header bar. It is here
                now — the one place in this panel that talks about the level as a
                whole rather than the tasks in it, and the only way to it, so it
                stays put while the list scrolls under it.
              */}
              <div
                class="sticky top-0 z-10 flex items-baseline justify-between gap-3 bg-ink-raised px-3 pb-2 pt-1"
              >
                <span class="lesson-eyebrow">Level {level.n} · {level.name}</span>
                <a
                  href={levelPath(level)}
                  class="whitespace-nowrap text-[11.5px] text-fg-dim transition-colors hover:text-accent"
                >
                  Overview
                </a>
              </div>

              <ol class="flex flex-col">
                {inLevel.map((lesson, index) => {
                  const isCurrent = lesson.id === current.id;
                  return (
                    <li>
                      <a
                        href={lessonPath(lesson)}
                        aria-current={isCurrent ? 'page' : undefined}
                        data-picker-item={lesson.data.slug}
                        class:list={[
                          'flex min-h-[44px] items-center gap-3 rounded-lg px-3 py-2 text-[13px] transition-colors',
                          isCurrent
                            ? 'bg-line text-fg'
                            : 'text-fg-dim hover:bg-line-faint hover:text-fg',
                        ]}
                      >
                        {/* fg-dim, not fg-faint: this panel is Raised, where fg-faint measures
                             4.34:1. There is no surface on which a text colour gets to be under AA. */}
                        <span
                          class="w-4 flex-none font-mono text-[11px] text-fg-dim"
                          data-picker-mark
                        >
                          {index + 1}
                        </span>
                        <span class="flex-1">{lesson.data.title}</span>
                        {lesson.data.challenge && (
                          <span class="flex-none font-mono text-[10px] uppercase tracking-[.08em] text-hint">
                            challenge
                          </span>
                        )}
                      </a>
                    </li>
                  );
                })}
              </ol>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</details>
