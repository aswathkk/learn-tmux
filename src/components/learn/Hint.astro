---
/**
 * The hint footer, pinned to the bottom of the task column.
 *
 * One quiet line — "Stuck on this one?" on the left, the way out on the right.
 * It sits below a hairline so it reads as the floor of the column rather than
 * another thing to read on the way down.
 *
 * Hints go from nudge to near-answer, so they are revealed one at a time, and a
 * hint already spent stays spent across reloads.
 */
import { renderInline } from '../../lib/inline-markdown';

interface Props {
  hints: string[];
  lessonSlug: string;
}

const { hints, lessonSlug } = Astro.props;

// Hints live in frontmatter, so the markdown pipeline never touched them.
const rendered = hints.map(renderInline);
---

<div
  class="learn-hint flex flex-none flex-col gap-3 border-t border-line px-5 pb-[22px] pt-[18px] lg:px-8"
  data-hints
  data-lesson={lessonSlug}
>
  {
    rendered.length > 0 && (
      <ol class="flex flex-col gap-[10px]" data-hint-list>
        {rendered.map((hint, index) => (
          <li
            class="flex gap-[11px] text-[13px] leading-[1.55] text-fg-muted"
            data-hint-index={index}
            hidden
          >
            <span class="flex-none font-mono text-[11px] text-hint">{index + 1}</span>
            <span set:html={hint} />
          </li>
        ))}
      </ol>
    )
  }

  <div class="flex min-h-[24px] items-center gap-[10px]">
    <span class="text-[12.5px] text-fg-dim" data-hint-prompt>
      {rendered.length > 0 ? 'Stuck on this one?' : 'No hints for this one.'}
    </span>
    {
      rendered.length > 0 && (
        <button
          type="button"
          data-hint-reveal
          class="ml-auto py-3 -my-3 pl-4 text-[12.5px] text-hint transition-opacity hover:opacity-80"
        >
          Show a hint
        </button>
      )
    }
  </div>
</div>
