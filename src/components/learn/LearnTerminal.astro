---
/**
 * The terminal column, exactly as designed: the machine, one line of status
 * under it, and nothing else.
 *
 * No app chrome on top of the terminal and no key toolbar beneath it. Every
 * character in the box comes from a Linux guest running in this tab, and the
 * design's point is that nothing should look painted on.
 *
 * The status line is the one place the machine gets to speak. It carries the
 * session, the grid size, and — while the machine is loading, booting or
 * broken — what it is doing. The client has always written to those last three
 * through `data-terminal-status`, `-status-text` and `-dot`, but no markup ever
 * carried them, so every status the machine reported went nowhere: the gate
 * vanished on click and the learner watched an empty black rectangle for the
 * length of a 15 MB download, and a failed boot said nothing at all.
 *
 * The editor overlay lives in here rather than in the layout because it covers
 * the machine exactly — it edits a file on the guest, so it opens over the
 * guest.
 */
import EditorOverlay from './EditorOverlay.astro';

interface Props {
  /**
   * Shown in the status line, e.g. "learn". Pass null where the page cannot
   * promise a session exists: the playground boots to a plain shell, and a
   * status line reading "session play" before anyone has run tmux is a lie
   * told by the one part of the screen that is meant to be the machine's.
   */
  session?: string | null;
  /**
   * Offer the full-screen toggle. Off by default: a lesson is the task and the
   * terminal together, and hiding the steps behind the thing they describe is
   * not a state a lesson wants to be in. The playground has no steps to hide.
   */
  fullscreen?: boolean;
  /**
   * The line under the gate's heading. A lesson describes the machine it is
   * about to run a task on; a page whose whole subject is the terminal says it
   * differently. The client reads whatever ships here, so this is the only
   * place either page states it.
   */
  gateBody?: string;
}

const {
  session = 'learn',
  fullscreen = false,
  gateBody = 'Alpine Linux and tmux 3.4 on an x86 emulator. Nothing to install, and no server behind it.',
} = Astro.props;
---

{/* Height and flex behaviour live in global.css: on a short window the box has
    to be able to give space back to the checklist below it. */}
<section
  class="learn-terminal-box relative overflow-hidden rounded-[9px] border border-line-strong bg-ink-term"
  aria-label="Terminal"
  data-terminal-box
>
  {/*
    The padding is on this wrapper, never on the mount. xterm's fit addon reads
    the computed height of the element it was opened in and only subtracts
    padding declared on xterm's own node, so padding here would make it size the
    grid to the full box and clip the tmux status line off the bottom.
  */}
  <div class="absolute inset-0 p-3">
    <div class="h-full w-full" data-terminal-mount></div>
  </div>

  {/*
    Tab belongs to the shell, so it cannot also be the way out of the terminal.
    Shift-Tab is (see src/lib/vm/terminal.ts), and a key that is not the usual
    one has to be said rather than found by trying keys until one works. Read on
    the way in, by the people who need it.
  */}
  <p class="sr-only">
    This is a live terminal. Typing goes to the machine, including Tab. Press Shift and Tab
    together to move focus back out to the page.
  </p>

  {/*
    Full screen puts the box in the top layer and leaves the status line, and
    its own toggle, behind on the page. Escape is the way back, so the box says
    so itself on the way in.
  */}
  <div
    class="pointer-events-none absolute inset-x-0 top-3 z-30 flex justify-center opacity-0 transition-opacity duration-300 data-[shown]:opacity-100"
    data-fullscreen-hint
    hidden
  >
    <span
      class="rounded-full border border-line-strong bg-ink-card px-3 py-[6px] font-mono text-[11.5px] text-fg-dim"
    >
      Esc leaves full screen
    </span>
  </div>

  {/*
    The start gate. The emulator is 15 MB and runs an x86 CPU on the main
    thread, so it is never booted on page load: the learner asks for it.

    It stays up through the download and the boot, with its own copy swapped for
    what the machine is doing, and it comes back if the machine fails — a black
    box with no way back into it is not a state to leave anyone in.
  */}
  <div
    class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-4 bg-ink-term px-6 text-center"
    data-terminal-gate
  >
    <div class="flex flex-col gap-[6px]">
      <p class="font-mono text-[13px] font-semibold text-fg" data-gate-title>
        A real terminal, in this tab
      </p>
      <p class="max-w-[38ch] text-[12.5px] leading-[1.5] text-fg-dim" data-gate-body>
        {gateBody}
      </p>
    </div>
    <button
      type="button"
      data-terminal-start
      class="min-h-[44px] rounded-lg bg-accent px-[18px] py-[11px] text-[13px] font-bold text-ink transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
    >
      Start the terminal
    </button>
    <p class="font-mono text-[11px] text-fg-faint" data-gate-note>about 15 MB, once</p>
  </div>

  {/* Boot progress, under the gate. */}
  <div class="pointer-events-none absolute inset-x-0 top-0 z-20 h-[2px]">
    <div class="h-full w-0 bg-accent transition-[width] duration-200" data-terminal-progress></div>
  </div>

  <EditorOverlay />
</section>

<div
  class="learn-terminal-status flex items-center gap-3 font-mono text-[11.5px] font-medium text-fg-faint"
>
  {/*
    Two spans, not one: the client rewrites the name when a screen starts a
    session of its own, and the size is written beside it from somewhere else.
  */}
  <span class="min-w-0 truncate">
    <span data-terminal-session>
      {
        session ? (
          <Fragment>
            session <span class="text-fg-dim">{session}</span>
          </Fragment>
        ) : (
          <span class="text-fg-dim">free play</span>
        )
      }
    </span><span data-terminal-size></span>
  </span>

  {/*
    What the machine is doing, when it is doing something. Empty at rest — the
    session and its size are the whole line until there is news.
  */}
  <span
    class="flex min-w-0 items-center gap-[7px]"
    data-terminal-status
    data-state="idle"
    aria-live="polite"
  >
    <span class="h-[6px] w-[6px] flex-none rounded-full" data-terminal-dot hidden></span>
    <span class="truncate" data-terminal-status-text></span>
  </span>

  <div class="ml-auto flex flex-none items-center gap-1">
    {/*
      Hidden until the client has checked the browser will allow it: a control
      that does nothing is worse than no control. iOS Safari is the case that
      matters — it has no element full screen at all.
    */}
    {
      fullscreen && (
        <button
          type="button"
          data-terminal-fullscreen
          aria-pressed="false"
          class="inline-flex items-center px-2 py-3 -my-3 text-fg-dim transition-colors hover:text-fg disabled:cursor-not-allowed disabled:text-fg-faint disabled:opacity-60 [@media(pointer:coarse)]:min-h-11"
          disabled
          hidden
        >
          Full screen
        </button>
      )
    }

    <button
      type="button"
      data-lesson-reset
      class="inline-flex items-center px-2 py-3 -my-3 -mr-2 text-fg-dim transition-colors hover:text-alert disabled:cursor-not-allowed disabled:text-fg-faint disabled:opacity-60 [@media(pointer:coarse)]:min-h-11"
      disabled
    >
      Reset
    </button>
  </div>
</div>
