---
/**
 * The "Task 7 of 10 ▾" control.
 *
 * A <details> element, so it opens and closes with no JavaScript at all and
 * still behaves for keyboard and screen-reader users. The list is real links,
 * which also means every task in the level is crawlable from every other one.
 */
import type { LessonEntry } from '../../lib/lessons';
import { lessonPath } from '../../lib/lessons';

interface Props {
  current: LessonEntry;
  siblings: LessonEntry[];
  position: number;
  totalInLevel: number;
}

const { current, siblings, position, totalInLevel } = Astro.props;
---
<details class="task-picker relative" data-task-picker>
  {/*
    The vertical padding is pulled back out with a negative margin: the control
    keeps the 20px it is drawn at and gets the 44px it is tapped at.
  */}
  <summary
    class="flex cursor-pointer list-none items-center gap-[6px] py-3 -my-3 text-[13px] text-fg-dim transition-colors hover:text-fg"
  >
    <span class="whitespace-nowrap">Task {position} of {totalInLevel}</span>
    <span aria-hidden="true" class="text-[10px] text-fg-faint">&#9662;</span>
  </summary>

  <div
    class="absolute left-0 top-[calc(100%+14px)] z-30 max-h-[min(70vh,420px)] w-[min(320px,calc(100vw-32px))] overflow-y-auto overscroll-contain rounded-xl border border-line-strong bg-ink-raised p-2 shadow-[0_24px_60px_rgba(0,0,0,.6)]"
  >
    <ol class="flex flex-col">
      {
        siblings.map((sibling, index) => {
          const isCurrent = sibling.id === current.id;
          return (
            <li>
              <a
                href={lessonPath(sibling)}
                aria-current={isCurrent ? 'page' : undefined}
                data-picker-item={sibling.data.slug}
                class:list={[
                  'flex min-h-[44px] items-center gap-3 rounded-lg px-3 py-2 text-[13px] transition-colors',
                  isCurrent ? 'bg-line text-fg' : 'text-fg-dim hover:bg-line-faint hover:text-fg',
                ]}
              >
                {/* fg-dim, not fg-faint: this panel is Raised, where fg-faint measures
                     4.34:1. There is no surface on which a text colour gets to be under AA. */}
                <span class="w-4 flex-none font-mono text-[11px] text-fg-dim" data-picker-mark>
                  {index + 1}
                </span>
                <span class="flex-1">{sibling.data.title}</span>
                {sibling.data.challenge && (
                  <span class="flex-none font-mono text-[10px] uppercase tracking-[.08em] text-hint">
                    challenge
                  </span>
                )}
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
</details>
