---
/**
 * One category of guides.
 *
 * A guide belongs to as many categories as it belongs to, so these pages
 * overlap on purpose: the config guide that also covers setup is listed on
 * both. Each page carries its own heading and lede — written per category in
 * src/lib/taxonomy.ts — because a page whose only content is a list of links to
 * other pages is a thin page, and thin pages neither rank nor read well.
 *
 * Only categories with a published guide get a page, which is the same tally
 * the chips are built from, so a chip can never lead to an empty page.
 */
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/ui/SiteHeader.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import CategoryChips from '../../../components/ui/CategoryChips.astro';
import GuideList from '../../../components/guides/GuideList.astro';
import {
  getGuides,
  guideCategoryTally,
  guidesInCategory,
  guidePath,
  type GuideEntry,
} from '../../../lib/guides';
import { guideCategoryPath, type GuideCategoryMeta } from '../../../lib/taxonomy';
import { breadcrumbJsonLd, itemListJsonLd } from '../../../lib/seo';

export async function getStaticPaths() {
  const all = await getGuides();
  const tally = guideCategoryTally(all);
  // The chips are the same on every one of these pages, so they are built once
  // here rather than re-read from the collection by each page.
  const chips = tally.map(({ category, count }) => ({
    href: guideCategoryPath(category.id),
    name: category.name,
    count,
  }));

  return tally.map(({ category }) => ({
    params: { category: category.id },
    props: { category, guides: guidesInCategory(all, category.id), total: all.length, chips },
  }));
}

interface Props {
  category: GuideCategoryMeta;
  guides: GuideEntry[];
  /** Every published guide, for the "All" chip. */
  total: number;
  chips: Array<{ href: string; name: string; count: number }>;
}

const { category, guides, total, chips } = Astro.props;
const path = guideCategoryPath(category.id);

const crumbs = [
  { name: 'learntmux', href: '/' },
  { name: 'Guides', href: '/guides' },
  { name: category.name },
];

const jsonLd = [
  breadcrumbJsonLd(crumbs, Astro.site),
  itemListJsonLd(
    guides.map((guide) => ({ name: guide.data.title, href: guidePath(guide) })),
    Astro.site,
  ),
];
---
<Base title={`${category.title} | learntmux`} description={category.blurb} jsonLd={jsonLd}>
  <SiteHeader section="guides" />

  <main id="main" class="mx-auto max-w-page px-5 py-12 sm:px-[clamp(20px,5vw,72px)]">
    <Breadcrumbs entries={crumbs} class="mb-8" />

    <header class="flex flex-col gap-4">
      <span class="font-mono text-xs font-medium uppercase tracking-[.12em] text-accent">
        {category.name}
      </span>
      <h1
        class="m-0 max-w-[20ch] font-bold [text-wrap:balance]"
        style="font-size:clamp(30px,3.8vw,44px); letter-spacing:-.03em; line-height:1.06;"
      >
        {category.heading}
      </h1>
      <p class="max-w-[58ch] text-base leading-[1.6] text-fg-muted [text-wrap:pretty]">
        {category.blurb}
      </p>
    </header>

    <CategoryChips
      class="mt-8"
      allHref="/guides"
      allLabel="All"
      total={total}
      active={path}
      items={chips}
    />

    <GuideList guides={guides} />

    <p class="border-t border-line pt-8 text-[13.5px] text-fg-dim">
      <a href="/guides" class="text-accent transition-colors hover:underline">All guides</a>, or{' '}
      <a href="/rss.xml" class="text-accent transition-colors hover:underline">subscribe by RSS</a>.
    </p>
  </main>
</Base>
