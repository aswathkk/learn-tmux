---
/**
 * One guide.
 *
 * Guides are the search-facing half of the site: the queries people type before
 * they know they want a course. Each one links into the lessons it builds on,
 * which is what turns a reader into a learner, and on into the next guide,
 * which is what keeps one who is not ready for a course yet.
 */
import { render, type CollectionEntry } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Article from '../../layouts/Article.astro';
import DraftBadge from '../../components/ui/DraftBadge.astro';
import Byline from '../../components/ui/Byline.astro';
import { guideCategory, guideCategoryPath } from '../../lib/taxonomy';
import { getGuides, guidePath, readNext, type GuideEntry } from '../../lib/guides';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/seo';
import { getLessons, lessonPath } from '../../lib/lessons';
import { readingTime } from '../../lib/reading-time';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide: GuideEntry) => ({
    params: { slug: guide.id },
    props: { guide, guides },
  }));
}

interface Props {
  guide: GuideEntry;
  guides: GuideEntry[];
}

const { guide, guides } = Astro.props;
const { Content } = await render(guide);
const data = guide.data;
const reading = readingTime(guide.body ?? '');

const lessons = await getLessons();
const related = data.relatedLessons
  .map((slug: string) => lessons.find((lesson) => lesson.data.slug === slug))
  .filter((lesson): lesson is (typeof lessons)[number] => Boolean(lesson));

const next = readNext(guide, guides);

/** The first category is the primary one: the trail can only hold one. */
const primary = guideCategory(data.categories[0]);

/**
 * The cover doubles as the social card, rasterised at a card's width. A guide
 * without one falls back to the site's own image rather than shipping a page
 * that unfurls as a bare link.
 */
const social = data.cover
  ? await getImage({ src: data.cover, width: 1200, format: 'png' })
  : undefined;

const path = guidePath(guide);
const crumbs = [
  { name: 'learntmux', href: '/' },
  { name: 'Guides', href: '/guides' },
  { name: primary.name, href: guideCategoryPath(data.categories[0]) },
  { name: data.title },
];

const jsonLd = [
  breadcrumbJsonLd(crumbs, Astro.site),
  articleJsonLd({
    title: data.title,
    description: data.description,
    path,
    published: data.published,
    updated: data.updated,
    image: social?.src,
    site: Astro.site,
  }),
];

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Article
  title={`${data.seoTitle ?? data.title} | learntmux`}
  description={data.description}
  crumbs={crumbs}
  jsonLd={jsonLd}
  image={social?.src}
  imageAlt={data.coverAlt}
  publishedTime={data.published}
  modifiedTime={data.updated}
  noindex={data.draft}
>
  <article class="flex flex-col gap-6">
    <header class="flex flex-col gap-3">
      {/* Every category the guide is filed under, each linking to its page, and
          all read from the same catalogue the index uses — so one guide cannot
          be filed under two different names on two different pages. */}
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        {data.categories.map((id) => (
          <a
            href={guideCategoryPath(id)}
            class="font-mono text-[11px] font-medium uppercase tracking-[.12em] text-accent transition-colors hover:underline"
          >
            {guideCategory(id).name}
          </a>
        ))}
        {data.draft && <DraftBadge />}
      </div>
      <h1
        class="m-0 font-bold [text-wrap:balance]"
        style="font-size:clamp(30px,3.6vw,46px); letter-spacing:-.03em; line-height:1.08;"
      >
        {data.title}
      </h1>
      <p class="text-[17px] leading-[1.55] text-fg-muted">{data.description}</p>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[12px] text-fg-dim">
        <time datetime={data.published.toISOString()}>{formatDate(data.published)}</time>
        {data.updated && (
          <>
            <span aria-hidden="true" class="text-fg-faint">·</span>
            <span>
              updated <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time>
            </span>
          </>
        )}
        <span aria-hidden="true" class="text-fg-faint">·</span>
        <span>{reading.label}</span>
        {data.author && <Byline author={data.author} size="md" class="ml-1" />}
      </p>
    </header>

    {
      data.cover && (
        /* The title is directly above it, so an unwritten alt would only say
           the same thing twice. */
        <Image
          src={data.cover}
          alt={data.coverAlt ?? ''}
          widths={[760, 1520]}
          sizes="(min-width: 900px) 760px, 100vw"
          class="aspect-[16/9] w-full rounded-xl border border-line object-cover"
          loading="eager"
        />
      )
    }

    <div class="lesson-prose text-[16px]">
      <Content />
    </div>

    {
      related.length > 0 && (
        <aside class="mt-6 flex flex-col gap-3 rounded-xl border border-accent/20 bg-accent/[.05] p-5">
          <h2 class="text-[15px] font-semibold text-fg">Practise this in a real terminal</h2>
          <ul class="flex flex-col gap-2">
            {related.map((lesson) => (
              <li>
                <a
                  href={lessonPath(lesson)}
                  class="-my-1 inline-flex py-1 text-[14px] text-accent transition-colors hover:underline"
                >
                  {lesson.data.title}
                </a>
                <span class="ml-2 text-[13px] text-fg-dim">{lesson.data.summary}</span>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    {
      next.length > 0 && (
        <nav class="mt-2 flex flex-col gap-4 border-t border-line pt-8" aria-label="Read next">
          <h2 class="m-0 font-mono text-[11px] font-medium uppercase tracking-[.12em] text-fg-dim">
            Read next
          </h2>
          <ul class="flex flex-col">
            {next.map((other: CollectionEntry<'guides'>) => (
              <li class="group relative flex flex-col gap-1 border-b border-line py-4 last:border-b-0 last:pb-0">
                <span class="font-mono text-[11px] text-accent">
                  {guideCategory(other.data.categories[0]).name}
                </span>
                <h3 class="m-0 text-[17px] font-semibold tracking-[-.015em]">
                  <a
                    href={guidePath(other)}
                    class="text-fg transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
                  >
                    {other.data.title}
                  </a>
                </h3>
                <p class="m-0 max-w-[62ch] text-[13.5px] leading-[1.55] text-fg-dim [text-wrap:pretty]">
                  {other.data.description}
                </p>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
</Article>
