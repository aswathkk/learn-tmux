---
/**
 * The landing page.
 *
 * The scroll-driven terminal is the one place on the site where the terminal is
 * a drawing rather than a machine, and it lands the idea before anyone has to
 * click.
 *
 * The page keeps no copy of the course. Counts, levels, tasks, keys and the
 * cheat sheet are all read from the content at build time.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/landing/Hero.astro';
import Levels from '../components/landing/Levels.astro';
import Lesson from '../components/landing/Lesson.astro';
import LevelComplete from '../components/landing/LevelComplete.astro';
import CheatSheet from '../components/landing/CheatSheet.astro';
import DemoTerminal from '../components/landing/DemoTerminal.astro';
import StartCta from '../components/landing/StartCta.astro';
import StartBar from '../components/landing/StartBar.astro';
import { getLandingContent } from '../lib/landing';
import { isoDuration } from '../lib/lessons';
import { courseJsonLd, itemListJsonLd } from '../lib/seo';

const content = await getLandingContent();
const { stats, levels } = content;

const title = 'learntmux — Learn tmux by doing it, not reading about it';
const description = `Open a real tmux session in your browser and start with a ${content.firstTask.minutes}-minute task. Sessions, panes, windows and your own .tmux.conf, learned by doing them — nothing to install and no account.`;

const jsonLd = [
  courseJsonLd({
    description,
    stats,
    duration: isoDuration(stats.minutes),
    site: Astro.site,
  }),
  itemListJsonLd(
    levels.map((entry) => ({ name: entry.level.name, href: entry.href })),
    Astro.site,
  ),
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <main id="main">
    <div class="stage">
      <div class="pin px-5 sm:px-[clamp(20px,5vw,72px)]">
        <div class="rail-grid mx-auto max-w-[1200px]">
          <div aria-hidden="true"></div>
          <DemoTerminal />
        </div>
      </div>
      <Hero startHref={content.startHref} firstTask={content.firstTask} />
      <Levels levels={levels} totalTasks={stats.lessons} />
      <Lesson />
    </div>
    <LevelComplete completion={content.completion} />
    <CheatSheet
      rows={content.cheatSheet.rows}
      total={content.cheatSheet.total}
      remaining={content.cheatSheet.remaining}
    />
    <StartCta firstTask={content.firstTask} startHref={content.startHref} />
  </main>

  <StartBar firstTask={content.firstTask} startHref={content.startHref} />

  <script>
    import { mountLandingProgress } from '../scripts/landing';
    mountLandingProgress();
  </script>
</Base>
